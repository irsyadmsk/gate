# Semua PUBLIC_* ikut dikirim ke browser. Jangan isi dengan secret/service-role key.
# Kosong = memakai konfigurasi publishable Irsyads yang sudah ada.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_GATE_ORIGIN=https://gate.irsyads.com
PUBLIC_GATE_CONSOLE=1
PUBLIC_GATE_REMOTE=1
# Opsional untuk build debug Android yang menunjuk proyek Supabase uji secara eksplisit.
PUBLIC_GATE_ANDROID_OAUTH_CLIENT_ID=
# Aktifkan halaman persetujuan hanya pada build situs staging yang memakai proyek uji.
PUBLIC_GATE_ANDROID_CONSENT_LOGIN_URL=

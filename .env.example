# Semua PUBLIC_* ikut dikirim ke browser. Jangan isi dengan secret/service-role key.
# Kosong = memakai konfigurasi publishable Irsyads yang sudah ada.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_GATE_ORIGIN=https://gate.irsyads.com
# Surel pengembang untuk halaman /privasi dan Play Console. Isi saat build web; kosong = halaman tanpa alamat (peringatan saat build).
PUBLIC_GATE_CONTACT_EMAIL=
